@model SchoolAppCoreMVC.Models.Enrollment

@{
    ViewData["Title"] = "Delete Enrollment";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Enrollment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Grade)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Grade)</dd>
        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.Course?.Title</dd>
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model.Student?.LastName @Model.Student?.FirstName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="EnrollmentID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
